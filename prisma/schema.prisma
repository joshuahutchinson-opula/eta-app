generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EXPLORER
  VENDOR
  ADMIN
}

enum Level {
  WANDERER
  EXPLORER
  TRAILBLAZER
  LOCAL_LEGEND
}

enum City {
  NEGRIL
  MONTEGO_BAY
}

enum VendorCategory {
  FOOD
  DRINKS
  ACTIVITY
  TRANSPORT
  WELLNESS
  BEACH
  ACCOMMODATION
  OTHER
}

enum AccommodationType {
  ALL_INCLUSIVE
  A_LA_CARTE
  VILLA
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum TransactionType {
  PAYMENT
  REWARD
  TOPUP
  TRANSFER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String?
  name          String
  role          Role     @default(EXPLORER)
  level         Level    @default(WANDERER)
  points        Int      @default(0)
  walletBalance Float    @default(0)
  streak        Int      @default(0)
  city          City     @default(NEGRIL)
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vendors         Vendor[]
  bookings        Booking[]
  discoveries     Discovery[]
  reviews         Review[]
  checkIns        CheckIn[]
  transactions    Transaction[]
  stories         Story[]
  moments         UserMoment[]
  crewGroups      CrewGroup[]
  crewMemberships CrewMember[]

  // Referral program: each user gets a shareable code lazily on first
  // request; referredById is set at registration when a valid code is used.
  referralCode       String?             @unique
  referredById       String?
  referredBy         User?               @relation("UserReferrals", fields: [referredById], references: [id])
  referredUsers      User[]              @relation("UserReferrals")
  referralsMade      Referral[]          @relation("ReferralReferrer")
  referralJoin       Referral?           @relation("ReferralReferee")
  trips              Trip[]
  alertSubscriptions AlertSubscription[]
}

model Vendor {
  id                   String         @id @default(cuid())
  name                 String
  category             VendorCategory
  neighborhood         String
  city                 City
  lat                  Float
  lng                  Float
  priceRange           String
  description          String
  instagram            String?
  website              String?
  images               String[]
  videos               String[]
  open                 Boolean        @default(false)
  live                 Boolean        @default(false)
  isPremium            Boolean        @default(false)
  isTransport          Boolean        @default(false)
  visibleInMarketplace Boolean        @default(true)
  visibleOnMap         Boolean        @default(true)
  menu                 Json?
  whoThere             Int            @default(0)
  tipsJar              Boolean        @default(false)
  payItForward         Boolean        @default(false)
  // Mobility/accessibility features the vendor has confirmed, as keys from
  // lib/accessibility.ts (e.g. WHEELCHAIR_ACCESSIBLE). Empty = not yet verified.
  accessibility        String[]       @default([])
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  ownerId              String?
  owner                User?          @relation(fields: [ownerId], references: [id])

  stories         Story[]
  reviews         Review[]
  checkIns        CheckIn[]
  transactions    Transaction[]
  experienceStops ExperienceStop[]
  bookings        Booking[]
  discoveries     Discovery[]
  flashDeals      FlashDeal[]
  tripStops       TripStop[]
}

model Accommodation {
  id          String            @id @default(cuid())
  name        String
  type        AccommodationType
  googleStars Float
  description String
  amenities   String[]
  priceRange  String
  lat         Float
  lng         Float
  city        City
  vetted      Boolean           @default(false)
  hostName    String?
  media       Json
  roomViews   String[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  bookings Booking[]
  bundles  Bundle[]
}

model Experience {
  id            String   @id @default(cuid())
  name          String
  tagline       String
  price         Float
  imageUrl      String
  videoUrl      String?
  city          City
  startLocation String
  travelTime    Int
  travelMode    String
  accessibility String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // An experience is an ordered route of vendor and photo-spot stops.
  stops     ExperienceStop[]
  bookings  Booking[]
  bundles   Bundle[]
  moods     Mood[]
  trips     Trip[]
  tripStops TripStop[]
}

enum StopType {
  VENDOR
  PHOTO_SPOT
}

enum TransportMode {
  WALKING
  TAXI
  BOAT
}

model ExperienceStop {
  id                      String         @id @default(cuid())
  order                   Int
  stopType                StopType
  // Minutes planned at this stop.
  plannedDuration         Int
  // How you get to the next stop; null on the last stop.
  transportModeToNext     TransportMode?
  transportDurationToNext Int?

  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  vendorId     String?
  vendor       Vendor?    @relation(fields: [vendorId], references: [id])
  photoSpotId  String?
  photoSpot    PhotoSpot? @relation(fields: [photoSpotId], references: [id])

  @@unique([experienceId, order])
}

model Mood {
  id          String   @id @default(cuid())
  name        String
  description String
  coverImage  String
  videoUrl    String?
  icon        String
  createdAt   DateTime @default(now())

  experiences Experience[]
  media       MoodMedia[]
}

model MoodMedia {
  id         String   @id @default(cuid())
  type       String
  url        String
  uploadedBy String
  createdAt  DateTime @default(now())

  moodId String
  mood   Mood   @relation(fields: [moodId], references: [id])
}

model PhotoSpot {
  id            String   @id @default(cuid())
  name          String
  description   String
  lat           Float
  lng           Float
  bestTime      String
  officialPhoto String
  gallery       String[] @default([])
  videos        String[] @default([])
  city          City
  createdAt     DateTime @default(now())

  userPhotos      UserMoment[]
  discoveries     Discovery[]
  tripStops       TripStop[]
  experienceStops ExperienceStop[]
}

model Story {
  id        String   @id @default(cuid())
  content   String
  type      String
  imageUrl  String
  createdAt DateTime @default(now())
  expiresAt DateTime

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])
}

model Booking {
  id           String        @id @default(cuid())
  status       BookingStatus @default(PENDING)
  date         DateTime
  totalPrice   Float
  pointsEarned Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  userId          String
  user            User           @relation(fields: [userId], references: [id])
  experienceId    String?
  experience      Experience?    @relation(fields: [experienceId], references: [id])
  vendorId        String?
  vendor          Vendor?        @relation(fields: [vendorId], references: [id])
  accommodationId String?
  accommodation   Accommodation? @relation(fields: [accommodationId], references: [id])
  trip            Trip?
}

model Discovery {
  id        String   @id @default(cuid())
  type      String
  points    Int      @default(0)
  createdAt DateTime @default(now())

  userId      String
  user        User       @relation(fields: [userId], references: [id])
  vendorId    String?
  vendor      Vendor?    @relation(fields: [vendorId], references: [id])
  photoSpotId String?
  photoSpot   PhotoSpot? @relation(fields: [photoSpotId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id])
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])
}

model CheckIn {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId   String
  user     User    @relation(fields: [userId], references: [id])
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])
}

model Transaction {
  id        String            @id @default(cuid())
  amount    Float
  type      TransactionType
  status    TransactionStatus @default(PENDING)
  createdAt DateTime          @default(now())

  userId   String
  user     User    @relation(fields: [userId], references: [id])
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])
}

model UserMoment {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  userId      String
  user        User       @relation(fields: [userId], references: [id])
  photoSpotId String?
  photoSpot   PhotoSpot? @relation(fields: [photoSpotId], references: [id])
}

model CrewGroup {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  creatorId String
  creator   User         @relation(fields: [creatorId], references: [id])
  members   CrewMember[]
}

model CrewMember {
  id           String   @id @default(cuid())
  isActive     Boolean  @default(true)
  lastLocation Json?
  joinedAt     DateTime @default(now())

  groupId String
  group   CrewGroup @relation(fields: [groupId], references: [id])
  userId  String
  user    User      @relation(fields: [userId], references: [id])
}

model FlashDeal {
  id        String   @id @default(cuid())
  deal      String
  expires   DateTime
  createdAt DateTime @default(now())

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])
}

model Bundle {
  id          String   @id @default(cuid())
  name        String
  discount    Float
  bonusPoints Int
  createdAt   DateTime @default(now())

  experienceId    String?
  experience      Experience?    @relation(fields: [experienceId], references: [id])
  accommodationId String?
  accommodation   Accommodation? @relation(fields: [accommodationId], references: [id])
}

enum TripStatus {
  PLANNING
  BOOKED
  COMPLETED
  CANCELLED
}

// A multi-stop plan. Used by the mobile Experiences flow (group planning,
// add-to-trip, offline cache, post-trip recap) and by the no-login web day
// planner - web trips have no owner and are edited with editKey instead.
model Trip {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  status    TripStatus @default(PLANNING)
  source    String     @default("app")
  city      City       @default(NEGRIL)
  date      DateTime?
  notes     String?
  editKey   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  ownerId      String?
  owner        User?       @relation(fields: [ownerId], references: [id])
  experienceId String?
  experience   Experience? @relation(fields: [experienceId], references: [id])
  bookingId    String?     @unique
  booking      Booking?    @relation(fields: [bookingId], references: [id])

  stops   TripStop[]
  members TripMember[]
}

model TripStop {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  time      String?
  note      String?
  addedBy   String?
  createdAt DateTime @default(now())

  tripId       String
  trip         Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vendorId     String?
  vendor       Vendor?     @relation(fields: [vendorId], references: [id])
  experienceId String?
  experience   Experience? @relation(fields: [experienceId], references: [id])
  photoSpotId  String?
  photoSpot    PhotoSpot?  @relation(fields: [photoSpotId], references: [id])
  votes        TripVote[]
}

model TripMember {
  id       String   @id @default(cuid())
  name     String
  isOwner  Boolean  @default(false)
  status   String   @default("pending")
  share    Float    @default(0)
  paid     Boolean  @default(false)
  joinedAt DateTime @default(now())

  tripId String
  trip   Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  votes  TripVote[]
}

model TripVote {
  id        String   @id @default(cuid())
  value     Int
  createdAt DateTime @default(now())

  stopId   String
  stop     TripStop   @relation(fields: [stopId], references: [id], onDelete: Cascade)
  memberId String
  member   TripMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([stopId, memberId])
}

// Opt-in web push subscription for time-sensitive local alerts.
model AlertSubscription {
  id             String   @id @default(cuid())
  endpoint       String   @unique
  p256dh         String
  auth           String
  savedVendorIds String[] @default([])
  liveAlerts     Boolean  @default(true)
  dealAlerts     Boolean  @default(true)
  lat            Float?
  lng            Float?
  radiusKm       Float    @default(3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId String?
  user   User?             @relation(fields: [userId], references: [id])
  sent   NotificationLog[]
}

// One row per alert delivered, so the same live session / flash deal never
// notifies the same device twice.
model NotificationLog {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  subscriptionId String
  subscription   AlertSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, key])
}

enum ReferralStatus {
  PENDING
  REWARDED
}

model Referral {
  id            String         @id @default(cuid())
  status        ReferralStatus @default(PENDING)
  pointsAwarded Int            @default(0)
  createdAt     DateTime       @default(now())
  rewardedAt    DateTime?

  referrerId String
  referrer   User   @relation("ReferralReferrer", fields: [referrerId], references: [id])
  refereeId  String @unique
  referee    User   @relation("ReferralReferee", fields: [refereeId], references: [id])
}

// Pre-launch waitlist (travelers) and vendor applications from the web app.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String
  type      String   @default("traveler")
  source    String?
  createdAt DateTime @default(now())

  @@unique([email, type])
}
