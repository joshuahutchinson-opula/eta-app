generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EXPLORER
  VENDOR
  ADMIN
}

enum Level {
  WANDERER
  EXPLORER
  TRAILBLAZER
  LOCAL_LEGEND
}

// Tourist towns, grouped into Jamaica's 14 parishes in lib/regions.ts.
// NEGRIL and MONTEGO_BAY are the original values; the rest were added for
// the region selector and can hold no data yet.
enum City {
  NEGRIL
  MONTEGO_BAY
  SAVANNA_LA_MAR
  LUCEA
  FALMOUTH
  OCHO_RIOS
  ST_ANNS_BAY
  RUNAWAY_BAY
  DISCOVERY_BAY
  TREASURE_BEACH
  BLACK_RIVER
  MANDEVILLE
  MAY_PEN
  SPANISH_TOWN
  KINGSTON
  PORT_ROYAL
  MORANT_BAY
  PORT_ANTONIO
  PORT_MARIA
  ORACABESSA
}

enum VendorCategory {
  FOOD
  DRINKS
  ACTIVITY
  TRANSPORT
  WELLNESS
  BEACH
  ACCOMMODATION
  OTHER
}

enum AccommodationType {
  ALL_INCLUSIVE
  A_LA_CARTE
  VILLA
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum TransactionType {
  PAYMENT
  REWARD
  TOPUP
  TRANSFER
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String?
  name           String
  role           Role     @default(EXPLORER)
  level          Level    @default(WANDERER)
  // Spendable points (go down when redeemed or donated).
  points         Int      @default(0)
  // Every point ever earned; only goes up. Status tier comes from this
  // (lib/rewardTiers.ts), so it never drops and carries across trips.
  lifetimePoints Int      @default(0)
  // The highest tier already celebrated (full-screen tier-up moment).
  tierSeen       String   @default("VISITOR")
  // One account per phone number (fraud protection), E.164.
  phone          String?  @unique
  // "MM-DD": Explorer and up earn double points on their birthday.
  birthday       String?
  // Demo leaderboard people (scripts/seed-rewards.ts).
  isMock         Boolean  @default(false)
  walletBalance  Float    @default(0)
  streak         Int      @default(0)
  city           City     @default(NEGRIL)
  avatarUrl      String?
  bio            String?
  homeCountry    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Null until the user opens the link in their verification email.
  // Unverified users can browse but not book, review or post.
  emailVerifiedAt       DateTime?
  // Bumped on log-out and account deletion; tokens carry the version they
  // were issued with, so older ones stop working (lib/auth-server.ts).
  tokenVersion          Int              @default(0)
  // Set when the user deletes their account; personal fields are wiped then.
  deletedAt             DateTime?
  // Which terms/privacy version the user agreed to at sign-up (lib/legal.ts).
  termsVersion          String?
  termsAcceptedAt       DateTime?
  // Who "I feel unsafe" shares the live location link with (Safety screen).
  emergencyContactName  String?
  emergencyContactPhone String?
  // Shown on the monthly leaderboard as first name + initial only.
  leaderboardOptIn      Boolean          @default(false)
  // Notification preferences per type, respected by every sender (lib/notify.ts).
  notifyBookings        Boolean          @default(true)
  notifyEvents          Boolean          @default(true)
  notifyDeals           Boolean          @default(true)
  notifyLive            Boolean          @default(true)
  notifyCrew            Boolean          @default(true)
  // Trip tips and the "planning your next trip?" nudge once they're home.
  notifyTrips           Boolean          @default(true)
  // WhatsApp copies of booking confirmations, reminders, receipts and crew
  // messages (lib/whatsapp.ts). Opt-in: WhatsApp requires it.
  whatsappNumber        String?
  notifyWhatsapp        Boolean          @default(false)
  // Instagram username, lowercase without the @. Story mentions of @ETA from
  // this account are matched to the vendor they QR-scanned at (lib/instagram.ts).
  instagramHandle       String?
  // Trip mode: the dates of the current (or last) trip, Jamaica days.
  tripStart             DateTime?
  tripEnd               DateTime?
  // Where they're staying: an ETA listing, a partner property, or just a town.
  stayName              String?
  stayCity              City?
  stayAccommodationId   String?
  // The hotel/villa partner whose code or QR brought them in (lib/partners.ts).
  partnerPropertyId     String?
  partnerJoinedAt       DateTime?
  partnerProperty       PartnerProperty? @relation("PartnerGuests", fields: [partnerPropertyId], references: [id], onDelete: SetNull)
  // A dropped pin, when the stay isn't listed (arrival flow).
  stayLat               Float?
  stayLng               Float?
  // When the "planning your next trip?" nudge last went out (one per trip).
  homeNudgeSentAt       DateTime?
  // The last Explore mode position fix (lib/explore.ts): explorer-only perks
  // unlock when the QR scan follows an Explore session near that vendor.
  exploreLastAt         DateTime?
  exploreLastLat        Float?
  exploreLastLng        Float?
  // Trip stages (lib/stage.ts): "LOCAL" (lives in Jamaica) or "VISITOR";
  // null until onboarding asks. The stage itself is inferred from this,
  // the travel trips and where the phone is.
  travelerType          String?
  // Cruise day: the port, the Jamaica day and the all-aboard time they entered.
  cruisePort            City?
  cruiseDay             String?
  cruiseAllAboardAt     DateTime?

  redemptions             Redemption[]
  dealClaims              FlashDealClaim[]
  reservationRequests     ReservationRequest[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  reports                 Report[]
  saved                   Saved[]
  savedLists              SavedList[]
  storyViews              StoryView[]
  eventInterests          EventInterest[]
  tickets                 Ticket[]
  tripMemberships         TripMember[]
  challengeCompletions    ChallengeCompletion[]
  notifications           NotificationLog[]
  safetyShares            SafetyShare[]

  vendors         Vendor[]
  bookings        Booking[]
  discoveries     Discovery[]
  reviews         Review[]
  checkIns        CheckIn[]
  transactions    Transaction[]
  stories         Story[]
  moments         UserMoment[]
  crewGroups      CrewGroup[]
  crewMemberships CrewMember[]

  // Referral program: each user gets a shareable code lazily on first
  // request; referredById is set at registration when a valid code is used.
  referralCode       String?             @unique
  referredById       String?
  referredBy         User?               @relation("UserReferrals", fields: [referredById], references: [id])
  referredUsers      User[]              @relation("UserReferrals")
  referralsMade      Referral[]          @relation("ReferralReferrer")
  referralJoin       Referral?           @relation("ReferralReferee")
  trips              Trip[]
  alertSubscriptions AlertSubscription[]
  hiddenGems         HiddenGem[]         @relation("GemSubmitter")
  gemConfirmations   GemConfirmation[]
  instagramMentions  InstagramMention[]
  tripRecaps         TripRecap[]
  ownedProperties    PartnerProperty[]   @relation("PartnerOwner")
  questProgress      QuestProgress[]
  questsCreated      Quest[]             @relation("QuestCreator")
  townMedia          TownMedia[]         @relation("TownMediaAuthor")
  travelTrips        TravelTrip[]        @relation("TravelTripOwner")
  travelTripMembers  TravelTripMember[]
  travelTripChanges  TravelTripChange[]
  reviewPrompts      ReviewPrompt[]
  eventInvites       EventInvite[]
  claimedVisits      PendingVisit[]
  storyReplies       StoryReply[]
  closeFriends       CloseFriend[]       @relation("CloseFriendOwner")
  closeFriendOf      CloseFriend[]       @relation("CloseFriendFriend")
  pointsLedger       PointsLedger[]
  donations          Donation[]
  userBadges         UserBadge[]
  fraudAlerts        FraudAlert[]

  @@index([instagramHandle])
}

model Vendor {
  id                   String               @id @default(cuid())
  name                 String
  category             VendorCategory
  neighborhood         String
  city                 City
  lat                  Float
  lng                  Float
  priceRange           String
  description          String
  instagram            String?
  website              String?
  images               String[]
  videos               String[]
  open                 Boolean              @default(false)
  live                 Boolean              @default(false)
  isPremium            Boolean              @default(false)
  // Indoor spot: rainy-day boosts apply here when rain is forecast.
  indoor               Boolean              @default(false)
  boosts               Boost[]
  // A local spot: cook shop, jerk centre or street food. Drives the
  // "Most local" badge on generated routes (lib/plan.ts).
  localSpot            Boolean              @default(false)
  isTransport          Boolean              @default(false)
  visibleInMarketplace Boolean              @default(true)
  visibleOnMap         Boolean              @default(true)
  menu                 Json?
  whoThere             Int                  @default(0)
  tipsJar              Boolean              @default(false)
  payItForward         Boolean              @default(false)
  // Mobility/accessibility features the vendor has confirmed, as keys from
  // lib/accessibility.ts (e.g. WHEELCHAIR_ACCESSIBLE). Empty = not yet verified.
  accessibility        String[]             @default([])
  // Weekly opening hours, Jamaica time: { mon: [["09:00","17:00"]], ... }.
  // A missing day means closed that day; a null value means hours not listed.
  hours                Json?
  phone                String?
  // Digits only with country code (e.g. 18765551234), for wa.me links.
  whatsapp             String?
  // What the vendor is pushing today: { name, price, imageUrl, videoUrl?, prepMinutes? }.
  dishOfDay            Json?
  acceptsReservations  Boolean              @default(false)
  // The partner property this vendor belongs to (its own restaurant, bar,
  // spa, activities). Guests paying here in the app is ETA's only cut.
  partnerPropertyId    String?
  partnerProperty      PartnerProperty?     @relation(fields: [partnerPropertyId], references: [id], onDelete: SetNull)
  // "Fair price, same as locals": the vendor confirms tourists pay what
  // locals pay. Set from the vendor app; the date is when they confirmed.
  fairPrice            Boolean              @default(false)
  fairPriceConfirmedAt DateTime?
  // How sure we are of lat/lng (see VendorLocationStatus). source: "vendor_gps",
  // "vendor_drag", "geocode_osm", "geocode_mapbox" or null for seed data.
  locationStatus       VendorLocationStatus @default(UNCONFIRMED)
  locationSource       String?
  locationAccuracyM    Float?
  locationUpdatedAt    DateTime?
  // Paid placement in Home's Featured carousel (labelled "Promoted") until then.
  promotedUntil        DateTime?
  // When videos last changed, so the Vibe feed counts them as fresh (14 days).
  videosUpdatedAt      DateTime?
  // Placeholder listing from the seed, not a real vetted vendor.
  // scripts/remove-mock-data.ts deletes everything flagged this way.
  isMock               Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  ownerId              String?
  owner                User?                @relation(fields: [ownerId], references: [id])

  menuItems            MenuItem[]
  rewardVendors        RewardVendor[]
  agreementAcceptances VendorAgreementAcceptance[]

  reservationRequests ReservationRequest[]
  redemptions         Redemption[]
  hostedEvents        Event[]
  stories             Story[]
  reviews             Review[]
  checkIns            CheckIn[]
  transactions        Transaction[]
  experienceStops     ExperienceStop[]
  bookings            Booking[]
  discoveries         Discovery[]
  flashDeals          FlashDeal[]
  tripStops           TripStop[]
  instagramMentions   InstagramMention[]
  taggedStories       Story[]              @relation("StoryPlace")
  qrCard              VendorQrCard?
  hostPicks           HostPick[]
  questsSponsored     Quest[]
  questCheckpoints    QuestCheckpoint[]
  transferServices    TransferService[]
  reviewPrompts       ReviewPrompt[]
  pendingVisits       PendingVisit[]
}

model Accommodation {
  id               String            @id @default(cuid())
  name             String
  type             AccommodationType
  googleStars      Float
  description      String
  amenities        String[]
  priceRange       String
  lat              Float
  lng              Float
  city             City
  vetted           Boolean           @default(false)
  hostName         String?
  media            Json
  roomViews        String[]
  // USD per night, shown as a guide. Stays are listings only: guests book
  // directly with the property (bookingUrl / phone / whatsapp / email).
  nightlyPrice     Float?
  bookingUrl       String?
  phone            String?
  // Digits only with country code, for wa.me links.
  whatsapp         String?
  email            String?
  maxGuests        Int?
  // Refund rules key from lib/cancellation.ts.
  cancellationTier String            @default("standard")
  isMock           Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Bookings made before stays became listings only, kept as history.
  bookings     Booking[]
  bundles      Bundle[]
  blockedDates AccommodationBlockedDate[]
  partner      PartnerProperty?
}

// A night the property can't be booked (owner block or sold out elsewhere).
model AccommodationBlockedDate {
  id     String   @id @default(cuid())
  // Midnight UTC of the night that's blocked.
  date   DateTime
  reason String?

  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  @@unique([accommodationId, date])
}

model Experience {
  id                 String   @id @default(cuid())
  name               String
  tagline            String
  price              Float
  imageUrl           String
  videoUrl           String?
  city               City
  startLocation      String
  travelTime         Int
  travelMode         String
  accessibility      String[] @default([])
  // What the price covers, one line each. Empty = not listed.
  included           String[] @default([])
  meetingPoint       String?
  meetingLat         Float?
  meetingLng         Float?
  cancellationPolicy String?
  // Start times offered, "HH:MM" 24h. Empty = any time the traveler picks.
  startTimes         String[] @default([])
  maxPartySize       Int?
  // Refund rules key from lib/cancellation.ts (flexible | standard | strict).
  // cancellationPolicy above is the vendor's own wording, shown alongside.
  cancellationTier   String   @default("standard")
  // Spots per start time (all party members count). Null = no limit listed.
  capacityPerSlot    Int?
  // Extra photos for the detail page gallery (imageUrl is the cover).
  gallery            String[] @default([])
  whatToBring        String[] @default([])
  // Free-text detail beyond the accessibility keys (steps, terrain, boats...).
  accessibilityNotes String?
  // Languages the guide speaks, e.g. ["English", "Patois", "Spanish"].
  guideLanguages     String[] @default([])
  // Rain-sensitive (Plan B, lib/plan-b.ts). Null = worked out from the stops:
  // beach, activity and photo-spot stops count as outdoor.
  outdoor            Boolean?
  isMock             Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  slots ExperienceSlot[]

  reviews   Review[]
  // An experience is an ordered route of vendor and photo-spot stops.
  stops     ExperienceStop[]
  bookings  Booking[]
  bundles   Bundle[]
  moods     Mood[]
  trips     Trip[]
  tripStops TripStop[]
  hostPicks HostPick[]
}

enum StopType {
  VENDOR
  PHOTO_SPOT
}

enum TransportMode {
  WALKING
  TAXI
  BOAT
}

model ExperienceStop {
  id                      String         @id @default(cuid())
  order                   Int
  stopType                StopType
  // Minutes planned at this stop.
  plannedDuration         Int
  // How you get to the next stop; null on the last stop.
  transportModeToNext     TransportMode?
  transportDurationToNext Int?

  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  vendorId     String?
  vendor       Vendor?    @relation(fields: [vendorId], references: [id])
  photoSpotId  String?
  photoSpot    PhotoSpot? @relation(fields: [photoSpotId], references: [id])

  @@unique([experienceId, order])
}

model Mood {
  id          String   @id @default(cuid())
  name        String
  description String
  coverImage  String
  videoUrl    String?
  icon        String
  createdAt   DateTime @default(now())

  experiences Experience[]
}

model PhotoSpot {
  id            String   @id @default(cuid())
  name          String
  description   String
  lat           Float
  lng           Float
  bestTime      String
  officialPhoto String
  gallery       String[] @default([])
  videos        String[] @default([])
  city          City
  createdAt     DateTime @default(now())

  userPhotos      UserMoment[]
  checkIns        CheckIn[]
  discoveries     Discovery[]
  tripStops       TripStop[]
  experienceStops ExperienceStop[]
}

model Story {
  id           String   @id @default(cuid())
  // The caption.
  content      String
  type         String
  // The photo, or the poster frame for a video story.
  imageUrl     String
  videoUrl     String?
  // Region the story was posted in (traveler stories); vendor stories use the vendor's town.
  city         City?
  hidden       Boolean  @default(false)
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  // The story editor's layers, drawn over the photo or video: text (font,
  // colour, position, size, angle) and stickers (location, vendor, event,
  // time), positions as fractions of the screen. The drawing is its own
  // transparent PNG (drawingUrl).
  overlays     Json?
  drawingUrl   String?
  // Only the poster's close friends see it (CloseFriend).
  closeFriends Boolean  @default(false)
  // A video posted with its sound off.
  muted        Boolean  @default(false)

  views   StoryView[]
  replies StoryReply[]

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])

  // Where a traveler story was taken, for its "Go here" button. Vendor
  // stories use vendorId; an event story points at the event ("Book this").
  placeVendorId String?
  placeVendor   Vendor? @relation("StoryPlace", fields: [placeVendorId], references: [id], onDelete: SetNull)
  eventId       String?
  event         Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
}

model Booking {
  id            String        @id @default(cuid())
  status        BookingStatus @default(PENDING)
  date          DateTime
  // Check-out for stays; null for single-day bookings.
  endDate       DateTime?
  // "HH:MM" start time the traveler picked, when the booking has one.
  time          String?
  partySize     Int           @default(1)
  // Per person (experiences) or per night (stays), before fees.
  unitPrice     Float?
  fees          Float         @default(0)
  totalPrice    Float
  pointsEarned  Int           @default(0)
  transactions  Transaction[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  cancelledAt   DateTime?
  // Refunded to the wallet on cancellation, per the cancellation policy.
  refundAmount  Float?
  // Set each time the traveler moves the booking to a new date/time.
  rescheduledAt DateTime?
  // Insider and up: the vendor sees it as a priority booking.
  priority      Boolean       @default(false)

  userId          String
  user            User           @relation(fields: [userId], references: [id])
  experienceId    String?
  experience      Experience?    @relation(fields: [experienceId], references: [id])
  vendorId        String?
  vendor          Vendor?        @relation(fields: [vendorId], references: [id])
  accommodationId String?
  accommodation   Accommodation? @relation(fields: [accommodationId], references: [id])
  trip            Trip?

  // Airport transfers (arrival flow): the service and the ride.
  transferServiceId String?
  transferService   TransferService? @relation(fields: [transferServiceId], references: [id], onDelete: SetNull)
  pickup            String?
  dropoff           String?
}

model Discovery {
  id        String   @id @default(cuid())
  type      String
  points    Int      @default(0)
  createdAt DateTime @default(now())

  userId      String
  user        User       @relation(fields: [userId], references: [id])
  vendorId    String?
  vendor      Vendor?    @relation(fields: [vendorId], references: [id])
  photoSpotId String?
  photoSpot   PhotoSpot? @relation(fields: [photoSpotId], references: [id])
  hiddenGemId String?
  hiddenGem   HiddenGem? @relation(fields: [hiddenGemId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId       String
  user         User        @relation(fields: [userId], references: [id])
  vendorId     String
  vendor       Vendor      @relation(fields: [vendorId], references: [id])
  // Set when the review is of an experience (vendorId is then its host).
  experienceId String?
  experience   Experience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)
}

model CheckIn {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  points    Int      @default(0)
  lat       Float?
  lng       Float?
  // "qr" = scanned the vendor's QR card on site (the vendor's proof of
  // visit); "gps" = location-only check-in (photo spots).
  method    String   @default("gps")
  accuracy  Float?
  // Distance from the place when checking in, metres.
  distanceM Int?

  userId      String
  user        User       @relation(fields: [userId], references: [id])
  vendorId    String?
  vendor      Vendor?    @relation(fields: [vendorId], references: [id])
  photoSpotId String?
  photoSpot   PhotoSpot? @relation(fields: [photoSpotId], references: [id])

  instagramMentions InstagramMention[]

  @@index([vendorId, createdAt])
  @@index([userId, createdAt])
}

model Transaction {
  id          String            @id @default(cuid())
  // Total charged, tip included.
  amount      Float
  tip         Float             @default(0)
  fees        Float             @default(0)
  description String?
  rail        String?
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  createdAt   DateTime          @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  vendorId  String?
  vendor    Vendor?  @relation(fields: [vendorId], references: [id])
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
}

model UserMoment {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  likes     Int      @default(0)
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId      String
  user        User       @relation(fields: [userId], references: [id])
  photoSpotId String?
  photoSpot   PhotoSpot? @relation(fields: [photoSpotId], references: [id])
}

model CrewGroup {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  creatorId String
  creator   User         @relation(fields: [creatorId], references: [id])
  members   CrewMember[]
}

model CrewMember {
  id           String   @id @default(cuid())
  isActive     Boolean  @default(true)
  lastLocation Json?
  joinedAt     DateTime @default(now())

  groupId String
  group   CrewGroup @relation(fields: [groupId], references: [id])
  userId  String
  user    User      @relation(fields: [userId], references: [id])
}

model FlashDeal {
  id        String   @id @default(cuid())
  deal      String
  expires   DateTime
  createdAt DateTime @default(now())

  vendorId String
  vendor   Vendor           @relation(fields: [vendorId], references: [id])
  claims   FlashDealClaim[]
}

// A traveler claiming a flash deal: the code is what they show the vendor.
model FlashDealClaim {
  id         String    @id @default(cuid())
  code       String    @unique
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())

  dealId String
  deal   FlashDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation(fields: [userId], references: [id])

  @@unique([dealId, userId])
}

model Bundle {
  id          String   @id @default(cuid())
  name        String
  discount    Float
  bonusPoints Int
  createdAt   DateTime @default(now())

  experienceId    String?
  experience      Experience?    @relation(fields: [experienceId], references: [id])
  accommodationId String?
  accommodation   Accommodation? @relation(fields: [accommodationId], references: [id])
}

enum TripStatus {
  PLANNING
  BOOKED
  COMPLETED
  CANCELLED
}

// A multi-stop plan. Used by the mobile Experiences flow (group planning,
// add-to-trip, offline cache, post-trip recap) and by the no-login web day
// planner - web trips have no owner and are edited with editKey instead.
model Trip {
  id               String     @id @default(cuid())
  slug             String     @unique
  name             String
  status           TripStatus @default(PLANNING)
  source           String     @default("app")
  city             City       @default(NEGRIL)
  date             DateTime?
  notes            String?
  editKey          String?
  // Which stop the crew is at on a booked trip; shared via the trip link.
  currentStopIndex Int        @default(0)
  // Read-only link for people outside the crew (Safety: share live trip).
  viewToken        String?    @unique
  // Each crew member pays their own share through the trip link.
  splitPayment     Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  ownerId      String?
  owner        User?       @relation(fields: [ownerId], references: [id])
  experienceId String?
  experience   Experience? @relation(fields: [experienceId], references: [id])
  bookingId    String?     @unique
  booking      Booking?    @relation(fields: [bookingId], references: [id])

  stops    TripStop[]
  members  TripMember[]
  invites  TripInvite[]
  messages TripMessage[]
}

model TripStop {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  time      String?
  note      String?
  addedBy   String?
  createdAt DateTime @default(now())

  tripId       String
  trip         Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vendorId     String?
  vendor       Vendor?     @relation(fields: [vendorId], references: [id])
  experienceId String?
  experience   Experience? @relation(fields: [experienceId], references: [id])
  photoSpotId  String?
  photoSpot    PhotoSpot?  @relation(fields: [photoSpotId], references: [id])
  votes        TripVote[]
}

model TripMember {
  id                String    @id @default(cuid())
  name              String
  isOwner           Boolean   @default(false)
  status            String    @default("pending")
  share             Float     @default(0)
  paid              Boolean   @default(false)
  paidAt            DateTime?
  // The wallet payment that covered this member's share.
  paidTransactionId String?
  joinedAt          DateTime  @default(now())
  // Live location, opt-in, shared with the crew only while the trip is booked.
  sharingLocation   Boolean   @default(false)
  lat               Float?
  lng               Float?
  locationAt        DateTime?

  tripId   String
  trip     Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  // Set when the member joined with their own account (invite link).
  userId   String?
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  votes    TripVote[]
  messages TripMessage[]

  @@unique([tripId, userId])
}

// A share link that lets someone join the crew with their own account.
model TripInvite {
  id         String    @id @default(cuid())
  token      String    @unique
  // Optional: who it's for (fills in their member name).
  name       String?
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?
  memberId   String?

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// Crew chat and quick messages ("Running late", "Here") on a trip.
model TripMessage {
  id        String   @id @default(cuid())
  body      String
  kind      String   @default("text")
  createdAt DateTime @default(now())

  tripId   String
  trip     Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  memberId String
  member   TripMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
}

model TripVote {
  id        String   @id @default(cuid())
  value     Int
  createdAt DateTime @default(now())

  stopId   String
  stop     TripStop   @relation(fields: [stopId], references: [id], onDelete: Cascade)
  memberId String
  member   TripMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([stopId, memberId])
}

// Opt-in web push subscription for time-sensitive local alerts.
model AlertSubscription {
  id             String   @id @default(cuid())
  endpoint       String   @unique
  p256dh         String
  auth           String
  savedVendorIds String[] @default([])
  liveAlerts     Boolean  @default(true)
  dealAlerts     Boolean  @default(true)
  lat            Float?
  lng            Float?
  radiusKm       Float    @default(3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId String?
  user   User?             @relation(fields: [userId], references: [id])
  sent   NotificationLog[]
}

// One row per alert delivered, so the same live session / flash deal never
// notifies the same device twice.
// The in-app inbox plus push de-duplication. Device alerts (live vendors,
// flash deals) are logged per subscription; account notifications
// (bookings, events, crew, reservations) per user (lib/notify.ts).
model NotificationLog {
  id        String    @id @default(cuid())
  key       String
  // bookings | events | deals | live | crew, matching the user's preferences.
  type      String?
  // What the alert said, for the in-app inbox.
  title     String?
  body      String?
  url       String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  subscriptionId String?
  subscription   AlertSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, key])
  @@unique([userId, key])
}

enum ReferralStatus {
  PENDING
  REWARDED
}

model Referral {
  id            String         @id @default(cuid())
  status        ReferralStatus @default(PENDING)
  pointsAwarded Int            @default(0)
  createdAt     DateTime       @default(now())
  rewardedAt    DateTime?

  referrerId String
  referrer   User   @relation("ReferralReferrer", fields: [referrerId], references: [id])
  refereeId  String @unique
  referee    User   @relation("ReferralReferee", fields: [refereeId], references: [id])
}

// Pre-launch waitlist (travelers) and vendor applications from the web app.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String
  type      String   @default("traveler")
  source    String?
  createdAt DateTime @default(now())

  @@unique([email, type])
}

enum GemCategory {
  WATERFALL
  HOT_SPRING
  CULTURAL_ARTIFACT
  VIEWPOINT
  STREET_ART
  SWIMMING_SPOT
  LOCAL_FAVOURITE
  OTHER
}

// Whether a vendor's pin is where they really are. CONFIRMED = the vendor set
// it on site from their phone (vendor app); UNCONFIRMED = seed data or a
// geocoded suggestion (scripts/suggest-vendor-locations.ts).
enum VendorLocationStatus {
  CONFIRMED
  UNCONFIRMED
}

enum GemStatus {
  PENDING
  VERIFIED
  REJECTED
}

// A traveler-submitted hidden spot. It stays fogged on the Discover map until
// someone is physically close; enough in-person confirmations verify it.
model HiddenGem {
  id                String      @id @default(cuid())
  name              String
  category          GemCategory
  description       String
  lat               Float
  lng               Float
  photos            String[]
  status            GemStatus   @default(PENDING)
  confirmationCount Int         @default(0)
  // The submitter's one-time bonus, paid when the gem is verified.
  submitterRewarded Boolean     @default(false)
  hidden            Boolean     @default(false)
  verifiedAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  submittedByUserId String
  submittedBy       User              @relation("GemSubmitter", fields: [submittedByUserId], references: [id])
  confirmations     GemConfirmation[]
  discoveries       Discovery[]

  @@index([status])
}

// One user confirming, in person, that a gem is real. One per user per gem.
model GemConfirmation {
  id          String   @id @default(cuid())
  confirmedAt DateTime @default(now())
  // Where the user was when they confirmed.
  lat         Float
  lng         Float

  userId String
  user   User      @relation(fields: [userId], references: [id])
  gemId  String
  gem    HiddenGem @relation(fields: [gemId], references: [id], onDelete: Cascade)

  @@unique([userId, gemId])
}

// Parties and events posted by promoters for This Week's Events. Not vendors:
// a promoter may not have a listing, and an event can be anywhere.
model Event {
  id             String    @id @default(cuid())
  title          String
  promoterName   String
  description    String
  imageUrl       String?
  videoUrl       String?
  venueName      String
  lat            Float?
  lng            Float?
  startAt        DateTime
  endAt          DateTime?
  // USD. Null with isFree false means price not listed.
  price          Float?
  isFree         Boolean   @default(false)
  ticketUrl      String?
  // In-app tickets (Get tickets). Without them, ticketUrl is the fallback.
  inAppTickets   Boolean   @default(false)
  ticketCapacity Int?
  city           City
  isMock         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tickets   Ticket[]
  interests EventInterest[]
  stories   Story[]
  hostPicks HostPick[]
  invites   EventInvite[]

  // A big night in town: Home's hero shows this event (its video) tonight.
  // Events with lots of interest count too (lib/home.ts partyNight).
  bigNight         Boolean   @default(false)
  // Insider and up can buy tickets before this; everyone after.
  earlyAccessUntil DateTime?

  // Optional: the venue's ETA listing, when it has one.
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  // Posted by a partner property (vendor app); shown to its guests first.
  partnerPropertyId String?
  partnerProperty   PartnerProperty? @relation(fields: [partnerPropertyId], references: [id], onDelete: SetNull)

  @@index([city, startAt])
}

enum RedemptionStatus {
  ACTIVE
  USED
  EXPIRED
}

// Points spent on a reward. The code (and its QR) is the voucher the
// traveler shows; the points are deducted when this row is created.
model Redemption {
  id            String           @id @default(cuid())
  rewardId      String
  rewardName    String
  pointCost     Int
  code          String           @unique
  status        RedemptionStatus @default(ACTIVE)
  expiresAt     DateTime?
  usedAt        DateTime?
  createdAt     DateTime         @default(now())
  // Set by the vendor when confirming: who confirmed and what the customer
  // spent on that visit (vendor ROI report).
  confirmedById String?
  spendAmount   Float?

  userId   String
  user     User    @relation(fields: [userId], references: [id])
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  @@index([rewardId, createdAt])
}

enum ReservationStatus {
  REQUESTED
  CONFIRMED
  DECLINED
}

// A table/slot request sent to a vendor; the vendor confirms it themselves.
model ReservationRequest {
  id          String            @id @default(cuid())
  date        DateTime
  time        String
  partySize   Int
  note        String?
  status      ReservationStatus @default(REQUESTED)
  // When the vendor accepted or declined, and anything they said.
  respondedAt DateTime?
  vendorNote  String?
  createdAt   DateTime          @default(now())

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  // sha256 of the token emailed to the user; the raw token is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  // sha256 of the token in the emailed link; the raw token is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Trust & safety ----------

enum ReportTarget {
  MOMENT
  STORY
  REVIEW
  HIDDEN_GEM
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

// A user flagging a photo, story, review or hidden gem. Content is hidden
// once REPORT_HIDE_THRESHOLD reports are pending (lib/reports.ts).
model Report {
  id         String       @id @default(cuid())
  targetType ReportTarget
  targetId   String
  reason     String
  note       String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([targetType, targetId, status])
}

// A vendor agreeing to a version of the vendor agreement (app/vendor-agreement).
// Written by the vendor app.
model VendorAgreementAcceptance {
  id               String   @id @default(cuid())
  version          String
  acceptedAt       DateTime @default(now())
  acceptedByUserId String?

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, version])
}

// Hospitals, clinics, tourist police and embassies for the Safety screen.
// Seeded numbers must be verified before launch (prisma/seed-extras.ts).
enum SafetyContactKind {
  HOSPITAL
  CLINIC
  TOURIST_POLICE
  EMBASSY
}

model SafetyContact {
  id        String            @id @default(cuid())
  kind      SafetyContactKind
  name      String
  phone     String?
  address   String?
  city      City?
  lat       Float?
  lng       Float?
  // Embassies: ISO code of the country it represents (US, CA, GB, DE).
  country   String?
  notes     String?
  verified  Boolean           @default(false)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
}

// "I feel unsafe": a live location link the app keeps updating while open.
model SafetyShare {
  id        String    @id @default(cuid())
  token     String    @unique
  lat       Float?
  lng       Float?
  accuracy  Float?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime
  endedAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Saved & collections ----------

enum SavedKind {
  VENDOR
  EXPERIENCE
  EVENT
}

model Saved {
  id        String    @id @default(cuid())
  kind      SavedKind
  refId     String
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, refId])
}

// Named lists of saved things ("Date night", "Day 2").
model SavedList {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  SavedListItem[]
}

model SavedListItem {
  id      String    @id @default(cuid())
  kind    SavedKind
  refId   String
  addedAt DateTime  @default(now())

  listId String
  list   SavedList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, kind, refId])
}

// ---------- Stories & events ----------

model StoryView {
  id       String   @id @default(cuid())
  viewedAt DateTime @default(now())

  storyId String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model EventInterest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

enum TicketStatus {
  CONFIRMED
  CANCELLED
  USED
}

// In-app event tickets. The code is what the QR encodes at the door.
model Ticket {
  id            String       @id @default(cuid())
  quantity      Int
  unitPrice     Float
  fees          Float        @default(0)
  totalPrice    Float
  status        TicketStatus @default(CONFIRMED)
  code          String       @unique
  transactionId String?
  usedAt        DateTime?
  cancelledAt   DateTime?
  refundAmount  Float?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])
}

// Per-slot overrides for an experience (the vendor app will write these):
// a different capacity on one date/time, or the slot closed.
model ExperienceSlot {
  id       String  @id @default(cuid())
  // Jamaica date, YYYY-MM-DD.
  date     String
  time     String
  capacity Int?
  closed   Boolean @default(false)

  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([experienceId, date, time])
}

// ---------- Vendors ----------

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  // USD. Null = price not listed.
  price       Float?
  imageUrl    String?
  // Keys from lib/dietary.ts: VEGETARIAN, VEGAN, SEAFOOD, HALAL, GLUTEN_FREE.
  dietaryTags String[] @default([])
  section     String?
  sortOrder   Int      @default(0)
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

// ---------- Rewards & challenges ----------

// The reward catalog. id is a stable slug (Redemption.rewardId).
model Reward {
  id                String   @id
  name              String
  description       String
  cost              Int
  icon              String
  minTier           String?
  validDays         Int
  // Null = available everywhere in Jamaica.
  city              City?
  active            Boolean  @default(true)
  sortOrder         Int      @default(0)
  // "catalog" = bought with points in Rewards. "welcome" = free, once per
  // traveler, handed out by the arrival moment or a partner property code
  // (lib/welcome.ts); cost is ignored. Configure these as data.
  kind              String   @default("catalog")
  // Locked until the traveler has QR-scanned at one of the reward's vendors.
  requiresVisit     Boolean  @default(false)
  // Rewards hub filter: "vendor" (vendor perks, vendor-funded), "insider"
  // (tier-only), "events" (early access, VIP entry) or "eta" (ETA perks:
  // ride and experience discounts, ETA-funded).
  category          String   @default("eta")
  // "all", or "local" for local-flavoured perks only residents see.
  audience          String   @default("all")
  // Every reward has caps: redemptions per Jamaica day and per month.
  dailyCap          Int      @default(20)
  monthlyBudget     Int      @default(300)
  // High-value rewards: the voucher QR rotates every 30 s, so a screenshot
  // can't be reused (lib/voucher-qr.ts).
  rotatingQr        Boolean  @default(false)
  // Event perks (early access, VIP entry) point at their event.
  eventId           String?
  // The vendor that created it in the vendor app (vendor-funded).
  createdByVendorId String?
  isMock            Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vendors           RewardVendor[]
  partnerProperties PartnerProperty[]
}

// Which vendors honour a reward.
model RewardVendor {
  rewardId String
  reward   Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([rewardId, vendorId])
}

// "Visit 3 new beaches this month". metric is a key from lib/challenges.ts.
model Challenge {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  metric      String
  target      Int
  bonusPoints Int
  // YYYY-MM, Jamaica time.
  month       String
  city        City?
  active      Boolean  @default(true)
  isMock      Boolean  @default(false)
  createdAt   DateTime @default(now())

  completions ChallengeCompletion[]
}

model ChallengeCompletion {
  id            String   @id @default(cuid())
  pointsAwarded Int
  completedAt   DateTime @default(now())

  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
}

// ---------- Search & infrastructure ----------

// What people search for, for "Popular searches". No user id is stored.
model SearchLog {
  id        String   @id @default(cuid())
  query     String
  city      City?
  results   Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Cached daily FX rate (lib/exchange-rate.ts). id is the pair, e.g. USD_JMD.
model ExchangeRate {
  id        String   @id
  rate      Float
  source    String
  fetchedAt DateTime
}

// ---------- Growth: partners, Instagram, trip recaps ----------

enum PartnerKind {
  HOTEL
  VILLA
}

// A hotel or villa that hands guests an ETA code (or its QR). Entering it
// presets the region, can hand out a welcome reward, and records the
// property as the guest's referrer (User.partnerPropertyId).
model PartnerProperty {
  id        String      @id @default(cuid())
  name      String
  // What guests type or scan, e.g. "SEASPLASH". Stored uppercase.
  code      String      @unique
  kind      PartnerKind @default(HOTEL)
  city      City
  lat       Float?
  lng       Float?
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // The perk guests get: a welcome reward (Reward.kind = "welcome").
  welcomeRewardId String?
  welcomeReward   Reward? @relation(fields: [welcomeRewardId], references: [id], onDelete: SetNull)
  guests          User[]  @relation("PartnerGuests")

  // Its stay listing, when it has one (photos, amenities, book-direct links).
  accommodationId String?        @unique
  accommodation   Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: SetNull)
  // Who runs it in the vendor app (a VENDOR-role user); admins can too.
  ownerId         String?
  owner           User?          @relation("PartnerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  imageUrl        String?

  vendors   Vendor[]
  events    Event[]
  hostPicks HostPick[]
}

// "Host's picks": what a partner property recommends to its guests, in its
// own order. Each pick is one vendor, experience or event, with a note.
model HostPick {
  id        String   @id @default(cuid())
  note      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  partnerPropertyId String
  partnerProperty   PartnerProperty @relation(fields: [partnerPropertyId], references: [id], onDelete: Cascade)
  vendorId          String?
  vendor            Vendor?         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  experienceId      String?
  experience        Experience?     @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  eventId           String?
  event             Event?          @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([partnerPropertyId, sortOrder])
}

// A vetted transfer a transport vendor offers from an airport (arrival flow).
// Fixed price: baseFare + perKm × the distance to the stay.
model TransferService {
  id           String   @id @default(cuid())
  // Airport code it serves (MBJ, KIN, OCJ, NEG).
  airport      String
  vehicle      String
  seats        Int
  baseFare     Float
  perKm        Float    @default(0)
  // How soon it can leave once booked.
  readyMinutes Int      @default(15)
  driverName   String?
  driverPhoto  String?
  // For the arrival's "Your driver is waiting" screen.
  driverPhone  String?
  plate        String?
  meetPoint    String?
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  vendorId String
  vendor   Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([airport, active])
}

enum MentionStatus {
  PENDING
  APPROVED
  REJECTED
}

// An Instagram story that mentioned @ETA, matched to a vendor the poster
// QR-scanned at shortly before (lib/instagram.ts). Only the Instagram media
// URL is kept, never the media itself; it shows in the vendor's ETA story
// once the vendor approves it, until expiresAt (24 h after it arrived).
model InstagramMention {
  id          String        @id @default(cuid())
  // Instagram-scoped id of the sender, from the webhook.
  igSenderId  String
  igUsername  String
  // The story's media URL on Instagram's CDN.
  mediaUrl    String
  mediaType   String        @default("image")
  // De-duplicates webhook retries (the message id).
  igMessageId String?       @unique
  status      MentionStatus @default(PENDING)
  receivedAt  DateTime      @default(now())
  expiresAt   DateTime
  decidedAt   DateTime?
  decidedById String?

  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkInId String?
  checkIn   CheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)

  @@index([vendorId, status, expiresAt])
}

// A shareable trip recap: everywhere they went between two dates. The
// token is the public link; the dates fix what it shows.
model TripRecap {
  id        String   @id @default(cuid())
  token     String   @unique
  start     DateTime
  end       DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, start, end])
}

// The secret on a vendor's printed QR card (lib/vendor-qr.ts). Scanning it
// on site is the proof of visit. Kept off the Vendor row so no vendor
// include or listing can ever send it to a traveler's app.
model VendorQrCard {
  vendorId String   @id
  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  token    String   @unique
  issuedAt DateTime @default(now())
}

// ---------- Explore mode: quests ----------

// A short trail of checkpoints with a clue each ("West End Cliffs: 5
// checkpoints"). Made by ETA or a vendor (vendor app); finishing earns the
// badge and rewardPoints, plus an explorer-only reward if one is attached.
model Quest {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String
  city         City
  badgeName    String
  rewardPoints Int      @default(200)
  // An explorer-only Reward (kind "explorer") handed out on finishing.
  rewardId     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation("QuestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  // The vendor that sponsors it, when a vendor made it.
  vendorId    String?
  vendor      Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  checkpoints QuestCheckpoint[]
  progress    QuestProgress[]
}

// One stop on a quest. Its location is never sent to the app until reached;
// the clue is what guides you there. Reached by being within radiusM, or by
// scanning vendorId's QR card when the checkpoint is a vendor.
model QuestCheckpoint {
  id      String @id @default(cuid())
  order   Int
  name    String
  clue    String
  lat     Float
  lng     Float
  radiusM Int    @default(75)

  questId  String
  quest    Quest                @relation(fields: [questId], references: [id], onDelete: Cascade)
  vendorId String?
  vendor   Vendor?              @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  hits     QuestCheckpointHit[]

  @@unique([questId, order])
}

model QuestProgress {
  id          String    @id @default(cuid())
  // Checkpoints reached so far, in order.
  reached     Int       @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  questId String
  quest   Quest                @relation(fields: [questId], references: [id], onDelete: Cascade)
  userId  String
  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  hits    QuestCheckpointHit[]

  @@unique([questId, userId])
}

model QuestCheckpointHit {
  id     String   @id @default(cuid())
  // "gps" or "qr".
  method String
  at     DateTime @default(now())

  progressId   String
  progress     QuestProgress   @relation(fields: [progressId], references: [id], onDelete: Cascade)
  checkpointId String
  checkpoint   QuestCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@unique([progressId, checkpointId])
}

// ---------- Home: Today story ----------

// ---------- Home: the hero's media per town and daypart ----------

// Photos and short muted loops of a town for each daypart (morning,
// afternoon, golden, night - lib/daypart.ts), uploaded by ETA admins in the
// vendor app (/api/vendor-app/town-media). Home's hero picks one for the
// selected town right now; without one it falls back to the town's best
// vendor photo.
model TownMedia {
  id        String   @id @default(cuid())
  city      City
  daypart   String
  // "photo" or "video".
  kind      String   @default("photo")
  url       String
  // A lighter copy for small screens / low data (720p video).
  urlSd     String?
  // The poster frame for a video.
  poster    String?
  // The photographer or videographer, shown small on the hero.
  credit    String?
  // Where it came from ("Pexels", "Pixabay"), its page and its licence.
  source    String?
  sourceUrl String?
  license   String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation("TownMediaAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([city, daypart, active])
}

// ---------- Trip stages: the traveler's trips to Jamaica ----------

// A trip: dates (Jamaica days), where they're staying and the town(s).
// "VISIT" flies in (countdown -> arrival -> on trip -> between trips);
// "GETAWAY" is a local's trip to another town (countdown and trip
// features, no airport or arrival screens). Status moves on only with a
// tap: UPCOMING -> ACTIVE (arrived) -> ENDED, or CANCELLED (deleted).
model TravelTrip {
  id                      String    @id @default(cuid())
  kind                    String    @default("VISIT")
  status                  String    @default("UPCOMING")
  city                    City
  startDate               DateTime
  endDate                 DateTime
  stayName                String?
  stayCity                City?
  stayAccommodationId     String?
  stayLat                 Float?
  stayLng                 Float?
  partnerPropertyId       String?
  // The airport they fly into (MBJ, KIN, OCJ, NEG), for the pre-booked ride.
  arrivalAirport          String?
  arrivedAt               DateTime?
  endedAt                 DateTime?
  // The welcome-back gift claimed for this trip (one per trip).
  welcomeBackRedemptionId String?
  // Friends join with this (the trip's invite link copies its dates and town).
  inviteCode              String    @unique
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  ownerId String
  owner   User   @relation("TravelTripOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  legs    TravelTripLeg[]
  members TravelTripMember[]
  changes TravelTripChange[]

  @@index([ownerId, startDate])
}

// Multi-town trips: each leg is a town and its dates; the location pill
// follows the current leg.
model TravelTripLeg {
  id        String   @id @default(cuid())
  city      City
  startDate DateTime
  endDate   DateTime
  order     Int      @default(0)

  tripId String
  trip   TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// Group trips: members share the dates and the stage.
model TravelTripMember {
  id       String   @id @default(cuid())
  joinedAt DateTime @default(now())

  tripId String
  trip   TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

// A date change on a group trip waits until every other member confirms it.
model TravelTripChange {
  id         String    @id @default(cuid())
  startDate  DateTime
  endDate    DateTime
  // pending | applied | declined
  status     String    @default("pending")
  approvedBy String[]  @default([])
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  tripId       String
  trip         TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  proposedById String
  proposedBy   User       @relation(fields: [proposedById], references: [id], onDelete: Cascade)

  @@index([tripId, status])
}

// ---------- Review at the right moment ----------

// Right after a QR visit or an in-app payment: "How was <vendor>?" One per
// vendor per Jamaica day. Skipped -> one reminder later that day.
model ReviewPrompt {
  id         String    @id @default(cuid())
  // "visit" or "payment".
  source     String
  sourceId   String?
  day        String
  createdAt  DateTime  @default(now())
  shownAt    DateTime?
  skippedAt  DateTime?
  remindedAt DateTime?
  doneAt     DateTime?

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, vendorId, day])
  @@index([userId, day])
}

// ---------- "I'm going, come with me" ----------

model EventInvite {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now())

  eventId   String
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviterId String
  inviter   User   @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@unique([eventId, inviterId])
}

// ---------- Vendor QR scanned without the app ----------

// The phone camera opened a vendor's QR on the web without an account: the
// visit is held here and credited if they sign up within 24 hours
// (lib/pending-visits.ts).
model PendingVisit {
  id         String    @id @default(cuid())
  claimToken String    @unique
  lat        Float?
  lng        Float?
  distanceM  Int?
  createdAt  DateTime  @default(now())
  claimedAt  DateTime?

  vendorId    String
  vendor      Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  claimedById String?
  claimedBy   User?   @relation(fields: [claimedById], references: [id], onDelete: SetNull)
}

// ---------- Stories: replies and close friends ----------

// A reply or an emoji reaction to a story. Vendors see the ones on their
// stories in the vendor app (/api/vendor-app/vendors/:id/story-replies);
// travelers see theirs at /api/stories/replies.
model StoryReply {
  id        String    @id @default(cuid())
  text      String?
  emoji     String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  storyId String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt])
}

// Who sees a traveler's "Close friends" stories.
model CloseFriend {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  ownerId  String
  owner    User   @relation("CloseFriendOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  friendId String
  friend   User   @relation("CloseFriendFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([ownerId, friendId])
}

// ---------- Rewards (lib/points-ledger.ts, lib/earn-config.ts) ----------

// Every change to a user's points: earns (+), spends and donations (-).
// reason is a code from lib/earn-config.ts; (userId, reason, sourceId) is
// unique, so the same thing can't pay out twice.
model PointsLedger {
  id         String   @id @default(cuid())
  points     Int
  // "earn" | "spend" | "donate"
  kind       String
  reason     String
  sourceType String?
  sourceId   String?
  // Where it was earned (vendor's town, or the user's), for the town leaderboard.
  city       City?
  vendorId   String?
  isMock     Boolean  @default(false)
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, sourceId])
  @@index([userId, createdAt])
  @@index([city, createdAt])
}

// Points multipliers and bonuses that stack on the base earn values.
//   quiet_hour  a vendor's 2x window (startMin-endMin, Jamaica minutes)
//   rainy_day   2x at indoor spots in the town when rain is forecast
//   crew        +bonus each when a whole group checks in together
model Boost {
  id         String   @id @default(cuid())
  kind       String
  title      String
  multiplier Float    @default(2)
  bonus      Int      @default(0)
  startMin   Int?
  endMin     Int?
  // Days of week it runs (0 = Sunday); empty = every day.
  days       Int[]    @default([])
  city       City?
  active     Boolean  @default(true)
  isMock     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([city, active])
  @@index([vendorId])
}

// Give Back: a local cause per town that points can be donated to.
// Admin-managed records.
model Cause {
  id           String   @id @default(cuid())
  city         City
  title        String
  body         String
  imageUrl     String?
  goalPoints   Int
  // Every unitPoints covers one unitLabel ("roofing supplies for a local family or small business").
  unitPoints   Int
  unitLabel    String
  raisedPoints Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  donations Donation[]

  @@index([city, active])
}

model Donation {
  id        String   @id @default(cuid())
  points    Int
  isMock    Boolean  @default(false)
  createdAt DateTime @default(now())

  causeId String
  cause   Cause  @relation(fields: [causeId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([causeId, createdAt])
}

// When a collectable badge (lib/badges.ts) was unlocked.
model UserBadge {
  id       String   @id @default(cuid())
  key      String
  earnedAt DateTime @default(now())
  isMock   Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// Unusually fast earning, for an admin to look at (lib/points-ledger.ts).
model FraudAlert {
  id         String    @id @default(cuid())
  kind       String
  detail     Json
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resolvedAt, createdAt])
}
