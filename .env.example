# .env.example — every setting ETA reads. Copy to .env and fill in what you
# use; anything optional left blank keeps that feature off (or logged only).

# ---- Required ----
DATABASE_URL=postgresql://user:pass@localhost:5433/eta
JWT_SECRET=                     # long random string: openssl rand -base64 48
NEXT_PUBLIC_SITE_URL=https://eta.example.com   # set before building

# ---- Jobs ----
CRON_SECRET=                    # x-cron-secret for /api/cron/reminders and /api/alerts/sweep

# ---- Email (Resend or Postmark) ----
EMAIL_PROVIDER=                 # resend | postmark (inferred from the key if blank)
EMAIL_API_KEY=
EMAIL_FROM=                     # "ETA <hello@eta.example.com>"

# ---- Push ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---- Uploads ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Sign in with Google / Apple ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---- Maps & routing (optional overrides) ----
NEXT_PUBLIC_MAPBOX_TOKEN=        # public, URL-restricted Mapbox token for every map (set before building)
# scripts/suggest-vendor-locations.ts only:
MAPBOX_GEOCODING_TOKEN=          # Mapbox token with permanent geocoding (for --provider=mapbox)
NOMINATIM_EMAIL=                 # optional contact sent to OpenStreetMap Nominatim
OSRM_FOOT_URL=
OSRM_DRIVING_URL=
EXCHANGE_RATE_URL=
REPORT_HIDE_THRESHOLD=

# ---- WhatsApp (lib/whatsapp.ts) — booking confirmations, reminders,
# receipts and crew invites, for travelers who opt in. Pick one provider.
WHATSAPP_PROVIDER=              # meta | twilio
# Meta WhatsApp Business Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_URL=             # default https://graph.facebook.com/v21.0
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=
WHATSAPP_TEMPLATE_BOOKING_REMINDER=
WHATSAPP_TEMPLATE_RECEIPT=
WHATSAPP_TEMPLATE_CREW_INVITE=
WHATSAPP_TEMPLATE_CREW=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=           # +18765550100
TWILIO_CONTENT_SID_BOOKING_CONFIRMED=
TWILIO_CONTENT_SID_BOOKING_REMINDER=
TWILIO_CONTENT_SID_RECEIPT=
TWILIO_CONTENT_SID_CREW_INVITE=
TWILIO_CONTENT_SID_CREW=

# ---- Instagram story mentions (lib/instagram.ts) — webhook at
# /api/webhooks/instagram. All three of the first block turn it on.
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_URL=            # default https://graph.instagram.com/v21.0
INSTAGRAM_MATCH_HOURS=4         # how recent the poster's QR scan must be
